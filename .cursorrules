## 14. MR Tracker — Monthly Metrics Endpoint Rules

### Correct Implementation Pattern
```typescript
app.get('/api/monthly-metrics', async (req, res) => {
  // 1. Parse target month FIRST
  const targetMonthStr = (req.query.month as string) || new Date().toISOString().slice(0, 7);
  const [targetYear, targetMonth] = targetMonthStr.split('-').map(Number);

  // 2. isTargetMonth uses PARSED values — not module-level closures
  const isTargetMonth = (dateStr: string) => {
    const d = new Date(dateStr);
    return d.getFullYear() === targetYear && d.getMonth() + 1 === targetMonth;
  };

  // 3. Try DB path first; on ANY error, log and fall through to memory
  if (dbReady && db) {
    try {
      const data = await db.repositories.getMonthlyMetrics(targetMonthStr);
      if (data.total_doctors > 0 || data.mr_performance?.length > 0) {
        return res.json(data);  // only return if we got real data
      }
    } catch (e) {
      console.error('[Metrics] DB path failed, using memory:', e);
    }
  }

  // 4. In-memory fallback — compute dates at REQUEST time
  const now = new Date();
  const today = now.toISOString().split('T')[0];
  // compute other relative dates here...
});
```

### Territory Matching — Flexible Rules
```typescript
// WRONG: exact match
const inTerritory = (d: any) => d.territory === mr.territory;

// CORRECT: bidirectional includes, case-insensitive
const inTerritory = (e: any) => {
  const et = (e.territory || e.area || '').toLowerCase();
  const mt = (mr.territory || '').toLowerCase();
  return et.includes(mt) || mt.includes(et) ||
         mt.split(',').some((t: string) => et.includes(t.trim()));
};
```

### "Reached" vs "Completed"
```typescript
// "Reached" = any visit scheduled (shows planning coverage)
const entitiesReached = unique entity IDs from ALL visits in target month;

// "Visits Completed" = visits with status === 'completed' (shows execution)
const visitsCompleted = visits.filter(v => v.status === 'completed').length;

// NEVER use completed-only for "reached" count — it always shows 0 for future months
```

